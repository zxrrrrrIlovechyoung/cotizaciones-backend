# Copiar este archivo a ".env" y ajustar si es necesario.
# NUNCA subir el archivo ".env" real al repositorio.

# En este equipo el puerto 3000 ya lo usa otro servicio (ComfyUI); usamos 3001.
APP_PORT=3001
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=cotizaciones_user
DB_PASSWORD=cotizaciones_pass
DB_NAME=cotizaciones_db
DB_SSLMODE=disable

JWT_SECRET=cambia-este-valor-por-uno-seguro-en-produccion
JWT_EXPIRATION_HOURS=24

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Recuperación por correo. SMTP_MODE: starttls (587) o tls (465).
# El modo none solo se permite en desarrollo y con un servidor local.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_MODE=starttls

# Ruta opcional al ejecutable de Chrome, Edge o Chromium para generar PDFs.
# Si se omite, la API busca el navegador en el sistema.
PDF_CHROMIUM_PATH=
